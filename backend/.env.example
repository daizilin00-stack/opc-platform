# OPC 数字平台 - 后端环境变量

NODE_ENV=development
PORT=3001

# 数据库
DATABASE_URL=postgresql://opc:opc_secret@localhost:5432/opc_db

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=opc-jwt-secret-2026-change-me-in-production

# 前端地址
FRONTEND_URL=http://localhost:3000

# 支付网关配置（当前仅 mock 模式可用，微信/支付宝待商户号开通）
PAYMENT_NOTIFY_BASE_URL=https://csdp-agentwork.com

# 微信支付商户号（Native 支付已开通，待 API 凭证配置）
WECHAT_PAY_MCHID=
WECHAT_PAY_APPID=
WECHAT_PAY_APIV3_KEY=
WECHAT_PAY_SERIAL=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=
WECHAT_PAY_PLATFORM_KEY_ID=
WECHAT_PAY_NOTIFY_URL=https://csdp-agentwork.com/api/payment/wechat/callback

# 支付宝商户号（电脑网站支付已开通）
ALIPAY_APP_ID=2021006190632420
ALIPAY_PRIVATE_KEY_PATH=./certs/alipay/app-private-key.pem
ALIPAY_PUBLIC_KEY_PATH=./certs/alipay/alipay-public-key.pem
ALIPAY_NOTIFY_URL=https://csdp-agentwork.com/api/payment/alipay/callback
