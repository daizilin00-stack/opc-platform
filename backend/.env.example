# OPC 数字平台 - 后端环境变量

NODE_ENV=development
PORT=3001

# 数据库
DATABASE_URL=postgresql://opc:opc_secret@localhost:5432/opc_db

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=opc-jwt-secret-2026-change-me-in-production

# 前端地址
FRONTEND_URL=http://localhost:3000

# 支付网关配置（当前仅 mock 模式可用，微信/支付宝待商户号开通）
PAYMENT_NOTIFY_BASE_URL=https://csdp-agentwork.com

# 微信支付商户号（待开通后填写）
WECHAT_MCH_ID=
WECHAT_APP_ID=
WECHAT_API_V3_KEY=
WECHAT_API_CERT_SERIAL_NO=
WECHAT_API_CERT_PRIVATE_KEY_PATH=
WECHAT_API_CERT_PUBLIC_KEY_PATH=

# 支付宝商户号（待开通后填写）
ALIPAY_APP_ID=
ALIPAY_APP_PRIVATE_KEY_PATH=
ALIPAY_PUBLIC_KEY_PATH=
ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do
